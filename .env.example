# Para uso local, nenhuma credencial é necessária.
ATRIO_STORAGE=sqlite
# Opcional: diretório do banco local fora de public/.
# ATRIO_DATA_DIR=.data

# Na Vercel, conecte um Blob Store privado ao projeto.
# A integração fornece BLOB_STORE_ID (OIDC) ou BLOB_READ_WRITE_TOKEN.
# A aplicação escolhe Blob automaticamente quando VERCEL=1.
